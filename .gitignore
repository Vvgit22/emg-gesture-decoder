# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data and run artefacts (never committed)
data/
artifacts/runs/**/*.log

# Trained weights and exported graphs (the two demo .onnx are force-added)
artifacts/models/
artifacts/onnx/
artifacts/experiments/*/predictions/
!artifacts/experiments/protocol_v1_analysis/predictions/
artifacts/experiments/protocol_v1_analysis/predictions/*
!artifacts/experiments/protocol_v1_analysis/predictions/README.md
!artifacts/experiments/protocol_v1_analysis/predictions/cnn/
!artifacts/experiments/protocol_v1_analysis/predictions/lda/
artifacts/experiments/protocol_v1_analysis/predictions/cnn/*
artifacts/experiments/protocol_v1_analysis/predictions/lda/*
!artifacts/experiments/protocol_v1_analysis/predictions/cnn/both/
!artifacts/experiments/protocol_v1_analysis/predictions/lda/both/
artifacts/experiments/protocol_v1_analysis/predictions/cnn/both/*
artifacts/experiments/protocol_v1_analysis/predictions/lda/both/*
